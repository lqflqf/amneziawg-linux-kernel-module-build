#!/usr/bin/make -f

include /usr/share/dpkg/pkg-info.mk

DKMS_DIR = /usr/src/amneziawg-$(DEB_VERSION_UPSTREAM)

%:
	dh $@

# The upstream source has no top-level build system. DKMS builds the module on the target system.
override_dh_auto_configure override_dh_auto_build override_dh_auto_test override_dh_auto_clean:

override_dh_auto_install:
	$(MAKE) -C src DESTDIR=$(CURDIR)/debian/amneziawg-dkms DKMSDIR=$(DKMS_DIR) dkms-install
	# Use debian/amneziawg-dkms.dkms, not the upstream src/dkms.conf.
	rm -f $(CURDIR)/debian/amneziawg-dkms$(DKMS_DIR)/dkms.conf
