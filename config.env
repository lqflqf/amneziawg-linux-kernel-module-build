# Settings of the published package repository.
PACKAGES_REPO=lqflqf/amneziawg-linux-kernel-module-packages
REPO_BASE_URL=https://lqflqf.github.io/amneziawg-linux-kernel-module-packages
REPO_ORIGIN=AmneziaWG
REPO_LABEL="AmneziaWG kernel module"
# Number of versions of each Debian package to keep in the APT pool.
DEB_KEEP_VERSIONS=3
# The APT Release files are valid for this number of days. The refresh-metadata workflow
# signs them again each week.
APT_VALID_DAYS=30
# File names of the public keys in the "keys" directory of the package repository.
APT_KEYRING_NAME=amneziawg-archive-keyring
# File name of the Alpine release signing key. The public key is keys/<name>.pub.
# Users install the public key with this name. Use a new name if you replace the key.
RELEASE_APK_KEY_NAME=amneziawg-packages.rsa
