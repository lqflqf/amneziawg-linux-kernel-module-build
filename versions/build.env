# Fixed build environment. A change to this file can change the packages.
# scripts/check-version-bump.py tells which versions to increase.
#
# Container images, pinned by digest. Get a new digest with:
#   docker buildx imagetools inspect alpine:3.24 | awk '/^Digest:/ {print $2; exit}'
IMAGE_ALPINE_3_24=alpine:3.24@sha256:be2656061b536c1883c4034790e21d0a09c5aaaf51968b89368a3c0371ea2c9a
IMAGE_ALPINE_3_23=alpine:3.23@sha256:ff7f0c727dd796aa36787bfcd9a64bf35a6ce72a73451b3359fde849b6703d63
IMAGE_DEBIAN_TRIXIE=debian:trixie@sha256:2dc419c6d7fe3dad0a2f9fd469c34cc90b0f9ba642d8fde837fe3d7d34a0e7f1
IMAGE_DEBIAN_BOOKWORM=debian:bookworm@sha256:d74df7598108a173a621eda4d58a2adbf850b2d9a9d81bc2cca1a6c21174a880
# Image of the offline signer container. It also builds the keyring APK.
SIGNER_BASE=alpine-3.24
# Image that builds the Debian packages (amneziawg-dkms and the keyring DEB).
DEB_BUILD_IMAGE=debian-trixie

# The Debian package is built with the packages of this snapshot.debian.org time stamp.
DEBIAN_SNAPSHOT=20261025T000000Z

# Version of the keyring packages (amneziawg-archive-keyring, amneziawg-keys).
# Increase it when you change the files in keys/.
KEYS_VERSION=2
# Fixed time stamp of the files in the keyring packages.
KEYS_EPOCH=1704067200
