# Fixed build inputs. Change this file to make a new release.
# A change to this file or to targets.json on branch "main" publishes the packages.
#
# AWG_*        : AmneziaWG kernel module source (upstream, not changed).
# AWG_VERSION  : module version. It must agree with AWG_TAG.
# DEB_REVISION : Debian package revision. Increase it for a Debian packaging change.
#                Set it to 1 when AWG_VERSION changes.
# AWG_TOOLS_*  : amneziawg-tools source. The installation tests use it. It is not packaged.

AWG_REPO=https://github.com/amnezia-vpn/amneziawg-linux-kernel-module.git
AWG_TAG=v3.1.20261113-02
AWG_COMMIT=63ed35de3d3f135b17e8eae0b84949e7700303be
AWG_VERSION=3.1.20261113.02
DEB_REVISION=1

AWG_TOOLS_REPO=https://github.com/amnezia-vpn/amneziawg-tools.git
AWG_TOOLS_TAG=v3.1.20260812
AWG_TOOLS_COMMIT=ee0f0a9aa34ff0a0da4b3433b9512781cfe02843
