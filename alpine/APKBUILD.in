# Contributor: amneziawg-linux-kernel-module-build
# Maintainer: AmneziaWG package builder <lqflqf@users.noreply.github.com>
#
# Template. scripts/build-apk.sh replaces the @...@ values from
# versions/upstream.env and versions/targets.json. Do not use this file directly.
_flavor=@FLAVOR@
_kver=@KVER@
_krel=@KREL@
_awgver=@AWG_VERSION@
_kpkgver="$_kver-r$_krel"
_kabi="$_kver-$_krel-$_flavor"

pkgname=amneziawg-$_flavor
pkgver=$_kver
pkgrel=@PKGREL@
pkgdesc="AmneziaWG $_awgver kernel module for linux-$_flavor $_kpkgver"
url="https://github.com/amnezia-vpn/amneziawg-linux-kernel-module"
arch="x86_64 aarch64"
license="GPL-2.0-only"
depends="linux-$_flavor=$_kpkgver"
makedepends="linux-$_flavor-dev=$_kpkgver"
install="$pkgname.post-install $pkgname.post-upgrade $pkgname.post-deinstall"
# !usrmerge: the Alpine kernel packages keep the modules in /lib/modules, thus this package must too.
# !archcheck: abuild cannot find the architecture in a compressed module (.ko.gz).
options="!check !usrmerge !archcheck"
source="amneziawg-linux-kernel-module-$_awgver.tar.gz"
builddir="$srcdir/amneziawg-linux-kernel-module-$_awgver"

build() {
	unset LDFLAGS
	# The latent_entropy GCC plugin of the kernel uses random values unless -frandom-seed is set.
	# A fixed seed makes the build reproducible.
	make -C src KERNELDIR="/usr/src/linux-headers-$_kabi" \
		KCFLAGS="-frandom-seed=amneziawg-$_awgver-$_kabi" module
}

package() {
	# Install the module like "make modules_install", but without depmod. The headers have no
	# System.map, thus depmod cannot run here. The post-install script runs depmod.
	# The Alpine kernel signing key is not public, thus the module is not signed.
	local dest="$pkgdir/lib/modules/$_kabi/extra" config="/usr/src/linux-headers-$_kabi/.config"
	install -Dm644 src/amneziawg.ko "$dest/amneziawg.ko"
	strip --strip-debug "$dest/amneziawg.ko"
	# Use the same compression as the modules of the kernel package.
	if grep -q '^CONFIG_MODULE_COMPRESS_GZIP=y' "$config"; then
		gzip -n -f "$dest/amneziawg.ko"
	elif grep -q '^CONFIG_MODULE_COMPRESS_XZ=y' "$config"; then
		xz --check=crc32 --lzma2=dict=1MiB -f "$dest/amneziawg.ko"
	elif grep -q '^CONFIG_MODULE_COMPRESS_ZSTD=y' "$config"; then
		zstd -q -T0 --rm -f "$dest/amneziawg.ko"
	fi
}
